.form { margin-top: 34rpx; padding: 28rpx; }.form-label { margin: 14rpx 0 12rpx; font-size: 28rpx; font-weight: 700; }.form-label text { margin-left: 12rpx; color: #aaa09d; font-size: 22rpx; font-weight: 400; }.form input, .form textarea { width: 100%; padding: 22rpx; border: 1rpx solid #f1e4e1; border-radius: 18rpx; background: #fffaf8; color: #342d2b; font-size: 27rpx; }.form textarea { height: 180rpx; }.success { padding-top: 80rpx; text-align: center; }.success-mark { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #eaf7ee; color: #65a477; font-size: 64rpx; }.success-title { font-size: 46rpx; font-weight: 700; }.code-card { margin: 40rpx 0 24rpx; padding: 30rpx; }.code-label { color: #9d918e; font-size: 24rpx; }.code { margin: 14rpx 0 20rpx; color: #c85e6b; font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; }.status-pill { display: inline-block; padding: 10rpx 24rpx; border-radius: 999rpx; background: #fff3df; color: #b17a2f; font-size: 24rpx; }
