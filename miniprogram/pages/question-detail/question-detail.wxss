.ask-form { margin-top: 34rpx; padding: 28rpx; }.form-label { margin-bottom: 14rpx; font-size: 28rpx; font-weight: 700; }.ask-form textarea { width: 100%; height: 300rpx; padding: 22rpx; border-radius: 18rpx; background: #fffaf8; font-size: 28rpx; }.form-hint { margin-top: 14rpx; color: #aaa09d; font-size: 22rpx; line-height: 1.6; }.question-head { padding: 20rpx 0 34rpx; }.detail-question { margin: 24rpx 0 14rpx; font-size: 40rpx; font-weight: 700; line-height: 1.5; }.answer { margin-bottom: 24rpx; padding: 30rpx; }.answer-label { color: #c85e6b; font-size: 25rpx; font-weight: 700; }.answer-text { margin-top: 18rpx; color: #685b58; font-size: 29rpx; line-height: 1.8; }.success { padding-top: 80rpx; text-align: center; }.success-mark { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #eaf7ee; color: #65a477; font-size: 64rpx; }.success-title { font-size: 46rpx; font-weight: 700; }
.ask-form input, .reply-form textarea { width: 100%; padding: 22rpx; border-radius: 18rpx; background: #fffaf8; font-size: 27rpx; }
.ask-form input { height: 84rpx; margin-bottom: 20rpx; }
.choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 18rpx; }
.choice { padding: 12rpx 20rpx; border-radius: 999rpx; background: #f5eeeb; color: #8e7f7b; font-size: 24rpx; }
.choice.selected { background: #d96d78; color: #fff; }
.agreement { margin: 24rpx 0 8rpx; color: #685b58; font-size: 24rpx; line-height: 1.6; }
.agreement text { color: #c85e6b; font-size: 34rpx; vertical-align: middle; }
.privacy-link { margin-bottom: 24rpx; color: #c85e6b; font-size: 24rpx; }
.detail-body { margin-top: 26rpx; color: #685b58; line-height: 1.8; }
.status-note { margin-top: 18rpx; color: #b17a2f; }
.reply-form { margin-bottom: 22rpx; padding: 26rpx; }
.reply-form textarea { height: 180rpx; }
.reply-form button { margin-top: 16rpx; }
.meta-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.report-link { flex: none; color: #9b7771; font-size: 23rpx; text-decoration: underline; }
.delete-post-btn { margin-top: 24rpx; border: 0; background: transparent; color: #ad4b52; font-size: 24rpx; text-decoration: underline; }
.delete-post-btn::after { border: 0; }
