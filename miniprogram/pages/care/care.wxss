.care-hero { position: relative; overflow: hidden; margin-top: 30rpx; padding: 34rpx; border-radius: 30rpx; background: linear-gradient(135deg, #fff0ed, #fff8e8); }.care-hero-title { font-size: 38rpx; font-weight: 700; }.care-hero-copy { width: 480rpx; margin-top: 12rpx; color: #856f6a; font-size: 25rpx; line-height: 1.7; }.care-flower { position: absolute; right: 44rpx; bottom: 18rpx; color: #e7a3a5; font-size: 110rpx; transform: rotate(-12deg); }.item-card { padding: 10rpx 26rpx; }.package-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3e7e4; color: #635754; font-size: 27rpx; }.package-item:last-child { border: 0; }.check { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 18rpx; border-radius: 50%; background: #edf8f0; color: #65a477; font-size: 23rpx; }.care-btn { margin-top: 20rpx; }
